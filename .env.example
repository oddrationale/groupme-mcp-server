# Copy to .env for local development. Never commit the real .env.
# In production these are set in the Prefect Horizon environment variable UI.

# GroupMe API access token. Optional at startup; required when a tool calls
# the API. Get one at https://dev.groupme.com
# GROUPME_ACCESS_TOKEN=

# Verbosity of the server's own logging.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
GROUPME_LOG_LEVEL=INFO

# Endpoint overrides, mainly for testing. Defaults shown.
# GROUPME_API_BASE_URL=https://api.groupme.com/v3
# GROUPME_IMAGE_API_BASE_URL=https://image.groupme.com

# Tracing is opt-in: spans are exported only when this is set (and
# OTEL_SDK_DISABLED is not truthy).
# OTEL_EXPORTER_OTLP_ENDPOINT=
