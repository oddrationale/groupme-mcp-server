# Copy to .env for local development. Never commit the real .env.
# In production the GROUPME_* / OTEL_* variables the server reads are set in
# the Prefect Horizon environment variable UI.

# GroupMe API access token. Optional at startup; required when a tool calls
# the API. Get one at https://dev.groupme.com
# GROUPME_ACCESS_TOKEN=

# Prefect Horizon API key, used only by local deployment tooling (e.g. the
# fastmcp CLI) to manage the hosted deployment. The server itself never reads
# it — do NOT register it on the deployed server.
# HORIZON_API_KEY=

# Verbosity of the server's own logging.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
GROUPME_LOG_LEVEL=INFO

# GroupMe REST API endpoint override, mainly for testing. Default shown.
# GROUPME_API_BASE_URL=https://api.groupme.com/v3

# Reserved for the image-upload tools; nothing reads it until image upload
# is implemented. Default shown.
# GROUPME_IMAGE_API_BASE_URL=https://image.groupme.com

# Tracing is opt-in: spans are exported only when the endpoint is set (and
# OTEL_SDK_DISABLED is not truthy).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=groupme-mcp-server
# OTEL_SDK_DISABLED=true
