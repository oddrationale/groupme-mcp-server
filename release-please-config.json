{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "groupme-mcp-server",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name==\"groupme-mcp-server\")].version"
        }
      ]
    }
  },
  "$comment": "Changelog sections are the release-type defaults: feat, fix, perf, deps, revert and docs are shown; chore, ci, build, refactor, test and style are hidden."
}
